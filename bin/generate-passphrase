#!/usr/bin/env bash
# generate-passphrase -- Generate a passphrase and validate its strength
# Author: Christopher Boone
# Date: 2026-03-29

# Security model:
#   - Passphrase lives only in a shell variable (not exported, not in env)
#   - printf is a shell builtin: piping it never exposes the value in ps/proc
#   - Pwned Passwords API uses k-anonymity: only the first 5 chars of the
#     SHA-1 hash leave the machine
#   - No temp files are created

# Exit codes:
#   0 - Success
#   1 - Passphrase found in breach database
#   2 - Missing required tool
#   3 - Word list not found

set -euo pipefail

# Resolve symlinks to find the real script location (portable, no readlink -f)
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  # Handle relative symlink targets
  [[ "${SOURCE}" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd "$(dirname "${SOURCE}")" && pwd)"
readonly SCRIPT_DIR
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly PROJECT_DIR
readonly WORD_LIST="${PROJECT_DIR}/passphrase-arcana.txt"
readonly DEFAULT_MINIMUM_ENTROPY=80

readonly E_SUCCESS=0
readonly E_PWNED=1
readonly E_MISSING_TOOL=2
readonly E_MISSING_WORD_LIST=3

# Print usage information.
# Outputs:
#   Writes usage text to stderr
function usage() {
  cat >&2 <<'USAGE_TEXT'
Usage: generate-passphrase [options] [minimum-entropy]

Generate a passphrase and validate its strength using multiple tools.
Diagnostics go to stderr; the passphrase goes to stdout.

Options:
  -c, --copy       Copy the passphrase to the clipboard (suppresses stdout)
                   Uses pbcopy (macOS), wl-copy (Wayland), or xclip (X11)
  -q, --quiet      Suppress diagnostics (stderr)
  -h, --help       Show this help message

Arguments:
  minimum-entropy  Minimum entropy in bits (default: 80)

Exit codes:
  0  Passphrase is clean
  1  Passphrase found in breach database

Examples:
  generate-passphrase                  # show diagnostics + passphrase
  generate-passphrase -c               # diagnostics on screen, passphrase to clipboard
  generate-passphrase -q               # just the passphrase
  generate-passphrase -qc              # silently copy to clipboard
  generate-passphrase | pbcopy         # pipe passphrase, diagnostics still visible
  generate-passphrase 100              # 100 bits minimum entropy

Tools used:
  phraze           Generate the passphrase
  keepassxc-cli    Independent entropy estimate
  zxcvbn           Password strength scoring (via Python, stdin)
  Pwned Passwords  Breach database check (k-anonymity, safe)
USAGE_TEXT
}

# Check that a required command is available. Exits on failure.
# Arguments:
#   $1 - Command name
#   $2 - Install hint (optional)
# Returns:
#   0 if found, exits with E_MISSING_TOOL if not
function require_command() {
  local cmd="${1}"
  local hint="${2:-}"

  if ! command -v "${cmd}" > /dev/null 2>&1; then
    echo "Error: ${cmd} is not installed." >&2
    [[ -n "${hint}" ]] && echo "  Install: ${hint}" >&2
    exit "${E_MISSING_TOOL}"
  fi
}

# Check whether an optional command is available.
# Arguments:
#   $1 - Command name
# Returns:
#   0 if found, 1 if not
function has_command() {
  command -v "${1}" > /dev/null 2>&1
}

# Detect the available clipboard command and build an argument array.
# On Wayland, wl-copy --sensitive hints clipboard managers to skip history.
# Sets: CLIP_CMD (array)
# Returns:
#   0 if a clipboard tool was found, exits with E_MISSING_TOOL if not
function detect_clipboard() {
  if has_command "pbcopy"; then
    CLIP_CMD=("pbcopy")
  elif has_command "wl-copy"; then
    CLIP_CMD=("wl-copy" "--sensitive")
  elif has_command "xclip"; then
    CLIP_CMD=("xclip" "-selection" "clipboard")
  elif has_command "xsel"; then
    CLIP_CMD=("xsel" "--clipboard" "--input")
  else
    echo "Error: no clipboard tool found (pbcopy, wl-copy, xclip, or xsel)." >&2
    exit "${E_MISSING_TOOL}"
  fi
}

# Generate a passphrase using phraze.
# Arguments:
#   $1 - Minimum entropy in bits
# Outputs:
#   Writes the phraze verbose output (entropy line + passphrase) to stdout
function generate_passphrase() {
  local -i minimum_entropy="${1}"

  phraze \
    --verbose \
    --sep " " \
    --custom-list "${WORD_LIST}" \
    --minimum-entropy "${minimum_entropy}"
}

# Check the passphrase against the Pwned Passwords API using k-anonymity.
# Only the first 5 characters of the SHA-1 hash are sent over the network.
# Arguments:
#   $1 - Passphrase to check
# Outputs:
#   Writes result to stderr
# Returns:
#   0 if not found, 1 if found in breaches
function check_pwned_passwords() {
  local passphrase="${1}"
  local sha1
  sha1="$(printf '%s' "${passphrase}" | shasum -a 1 | awk '{print toupper($1)}')"

  local prefix="${sha1:0:5}"
  local suffix="${sha1:5}"

  local response
  response="$(curl --silent --fail "https://api.pwnedpasswords.com/range/${prefix}")"

  if printf '%s' "${response}" | grep -qi "^${suffix}:"; then
    local count
    count="$(printf '%s' "${response}" | grep -i "^${suffix}:" | cut -d: -f2 | tr -d '\r')"
    echo "FOUND in ${count} breaches" >&2
    return 1
  fi

  echo "Not found in any known breaches" >&2
}

# Run zxcvbn password strength analysis via Python (reads from stdin).
# Arguments:
#   $1 - Passphrase to check
# Outputs:
#   Writes zxcvbn results to stderr
function check_zxcvbn() {
  local passphrase="${1}"

  printf '%s' "${passphrase}" | uv run python3 -c "
import sys
from zxcvbn import zxcvbn
r = zxcvbn(sys.stdin.read())
times = r['crack_times_display']
secs = r['crack_times_seconds']
print(f\"Score: {r['score']}/4\")
print(f\"Guesses: {r['guesses']:.2e} (log10: {r['guesses_log10']:.1f})\")
print(f\"Online (throttled):  {times['online_throttling_100_per_hour']:>10s} ({float(secs['online_throttling_100_per_hour']):.2e}s)\")
print(f\"Online (unthrottled): {times['online_no_throttling_10_per_second']:>9s} ({float(secs['online_no_throttling_10_per_second']):.2e}s)\")
print(f\"Offline (slow hash): {times['offline_slow_hashing_1e4_per_second']:>10s} ({float(secs['offline_slow_hashing_1e4_per_second']):.2e}s)\")
print(f\"Offline (fast hash): {times['offline_fast_hashing_1e10_per_second']:>10s} ({float(secs['offline_fast_hashing_1e10_per_second']):.2e}s)\")
if r['feedback']['warning']:
    print(f\"Warning: {r['feedback']['warning']}\")
for s in r['feedback']['suggestions']:
    print(f\"Suggestion: {s}\")
print()
print('Sequence:')
for s in r['sequence']:
    pattern = s['pattern']
    token = s['token']
    log10 = s['guesses_log10']
    detail = ''
    if pattern == 'dictionary':
        detail = f\" ({s['dictionary_name']}: {s['matched_word']}#{s['rank']})\"
        if s.get('l33t'):
            detail += ' [l33t]'
        if s.get('reversed'):
            detail += ' [reversed]'
    print(f\"  {token!r:20s} {pattern:12s} log10: {log10:5.1f}{detail}\")
" >&2
}

# Run keepassxc-cli entropy estimate (reads from stdin).
# Arguments:
#   $1 - Passphrase to check
# Outputs:
#   Writes keepassxc-cli output to stderr
function check_keepassxc() {
  local passphrase="${1}"

  printf '%s' "${passphrase}" | keepassxc-cli estimate --advanced >&2
}

function main() {
  local copy_to_clipboard=false
  local quiet=false

  while [[ "${1:-}" == -* ]]; do
    case "${1}" in
      -c | --copy)
        copy_to_clipboard=true
        shift
        ;;
      -q | --quiet)
        quiet=true
        shift
        ;;
      -h | --help)
        usage
        exit "${E_SUCCESS}"
        ;;
      --)
        shift
        break
        ;;
      -[!-]?*)
        # Expand combined short flags (-qc -> -q -c)
        local combined="${1}"
        shift
        local -i i
        for ((i = 1; i < ${#combined}; i++)); do
          set -- "-${combined:i:1}" "${@}"
        done
        ;;
      *)
        echo "Unknown option: ${1}" >&2
        usage
        exit 1
        ;;
    esac
  done

  local -i minimum_entropy="${1:-${DEFAULT_MINIMUM_ENTROPY}}"

  # phraze is the only hard requirement
  require_command "phraze" "cargo install phraze"

  # Detect optional tools
  local has_zxcvbn=false
  local has_keepassxc=false
  local has_pwned=false

  if has_command "uv"; then
    has_zxcvbn=true
  fi

  if has_command "keepassxc-cli"; then
    has_keepassxc=true
  fi

  if has_command "curl" && has_command "shasum"; then
    has_pwned=true
  fi

  if [[ "${copy_to_clipboard}" == true ]]; then
    detect_clipboard
  fi

  if [[ ! -f "${WORD_LIST}" ]]; then
    echo "Error: word list not found at ${WORD_LIST}" >&2
    echo "  Run 'make build' to generate it." >&2
    exit "${E_MISSING_WORD_LIST}"
  fi

  # Suppress diagnostics in quiet mode
  if [[ "${quiet}" == true ]]; then
    exec 2>/dev/null
  fi

  # Generate the passphrase
  # phraze writes the entropy line to stderr and the passphrase to stdout.
  # Merge both into a single capture, then split with parameter expansion
  # (pure bash, no temp files, no subshells).
  local phraze_output
  phraze_output="$(generate_passphrase "${minimum_entropy}" 2>&1)"

  # Line 1 = entropy info, line 2 = passphrase
  local entropy_line="${phraze_output%%$'\n'*}"
  local passphrase="${phraze_output##*$'\n'}"

  # Diagnostics to stderr
  echo "=== phraze ===" >&2
  echo "${entropy_line}" >&2

  echo "" >&2
  echo "=== zxcvbn ===" >&2
  if [[ "${has_zxcvbn}" == true ]]; then
    check_zxcvbn "${passphrase}"
  else
    echo "(skipped: uv not installed)" >&2
  fi

  echo "" >&2
  echo "=== keepassxc-cli ===" >&2
  if [[ "${has_keepassxc}" == true ]]; then
    check_keepassxc "${passphrase}"
  else
    echo "(skipped: keepassxc-cli not installed)" >&2
  fi

  echo "" >&2
  echo "=== Pwned Passwords (k-anonymity) ===" >&2
  local pwned_ok=true
  if [[ "${has_pwned}" == true ]]; then
    if ! check_pwned_passwords "${passphrase}"; then
      pwned_ok=false
    fi
  else
    echo "(skipped: curl or shasum not installed)" >&2
  fi

  # On pwned failure, send passphrase to stderr (visible for debugging,
  # but not piped downstream or copied to clipboard) and exit non-zero.
  if [[ "${pwned_ok}" == false ]]; then
    echo "" >&2
    echo "=== Passphrase (NOT SAFE) ===" >&2
    echo "${passphrase}" >&2
    exit "${E_PWNED}"
  fi

  # Passphrase to stdout (or clipboard)
  if [[ "${copy_to_clipboard}" == true ]]; then
    printf '%s' "${passphrase}" | "${CLIP_CMD[@]}"
    echo "" >&2
    echo "=== Passphrase ===" >&2
    echo "(copied to clipboard)" >&2
  else
    echo "${passphrase}"
  fi
}

main "${@}"
